#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        /* 组合触发：Tab+W+S 开始蓝牙广播配对 */
        bt_pair_trigger: bt_pair_trigger {
            compatible = "zmk,behavior-hold-tap";
            label = "BT_PAIR_TRIGGER";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&bt BT_START_ADV>;
            hold-trigger-key-positions = <11 0 2>; /* Tab W S */
            hold-trigger-on-release;
        };

        /* 组合触发：Tab+A+D 清除蓝牙全部配对 */
        bt_clear_trigger: bt_clear_trigger {
            compatible = "zmk,behavior-hold-tap";
            label = "BT_CLEAR_TRIGGER";
            #binding-cells = <0>;
            tapping-term-ms = <100>;
            bindings = <&bt BT_CLR_ALL>;
            hold-trigger-key-positions = <11 1 3>; /* Tab A D */
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp KC_W,         // index0 P0.17 W
                &kp KC_A,         // index1 P0.20 A
                &kp KC_S,         // index2 P0.22 S
                &kp KC_D,         // index3 P0.24 D
                &kp KC_SPACE,     // index4 P0.09 空格
                &kp KC_F,         // index5 P1.04 F
                &kp KC_E,         // index6 P0.10 E
                &kp KC_UP,        // index7 P0.11 上
                &kp KC_DOWN,      // index8 P1.11 下
                &kp KC_R,         // index9 P1.00 R
                &kp KC_LALT,      // index10 P1.06 Alt
                &bt_pair_trigger &bt_clear_trigger &kp KC_TAB  // index11 P1.13 Tab
            >;
        };
    };
};
