#include <behaviors.dtsi>
#include <dt‑bindings/zmk/keys.h>
#include <dt‑bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
//顺序严格和dtsi的gpios一一对应！
            bindings =
                <&kp W>,
                <&kp A>,
                <&kp S>,
                <&kp D>,
                <&kp SPACE>,
                <&kp F>,
                <&kp E>,
                <&kp UP>,
                <&kp DOWN>,
                <&kp R>,
                <&kp LALT>,
                <&kp TAB>;

// 宏触发：同时按下 Tab(W‑S) 触发配对；Tab(A‑D)清除配对
            combos {
                combo_bt_pair {
                    keys = <11 0 2>; //Tab(11),W(0),S(2)
                    bindings = <&macro_pair>;
                    timeout-ms = 100;
                };
                combo_bt_clear {
                    keys = <11 1 3>; //Tab(11),A(1),D(3)
                    bindings = <&macro_clear>;
                    timeout-ms = 100;
                };
            };
        };
    };
};
